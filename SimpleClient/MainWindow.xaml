<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SimpleClient.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Simple API Client">

    <StackPanel Padding="32" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">

        <TextBlock Text="Simple API Client" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Input -->
        <TextBlock Text="Input" />
        <TextBox x:Name="InputBox" PlaceholderText="Type something..." />

        <!-- Submit button -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="SubmitButton" Content="Submit" Click="SubmitButton_Click" Style="{StaticResource AccentButtonStyle}" />
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Output -->
        <TextBlock Text="Output" />
        <TextBox x:Name="OutputBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="60" />

    </StackPanel>
</Window>
