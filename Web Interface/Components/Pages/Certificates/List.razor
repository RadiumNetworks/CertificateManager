@page "/certificates/list"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using CertificateManager.Models
@using CertificateManager.Models.Views
@using CertificateManager.Data
@using Microsoft.AspNetCore.Components.QuickGrid
@using CertificateManager.Services
@using Microsoft.AspNetCore.Components.Authorization

@implements IAsyncDisposable
@inject CertificateService certificateService
@inject UserRolesService UserRolesService

<PageTitle>Certificate Entries</PageTitle>

<h3>List certificate database entries</h3>

<EditForm Model="entry" OnSubmit="HandleSubmit">
    <table>
        <tr>
            <td><label for="SubjectFilter">Subject</label></td>
            <td><InputText id="SubjectFilter" @bind-Value="@SubjectFilter"></InputText></td>
        </tr>
        <tr>
            <td><label for="OwnerFilter">Owner</label></td>
            <td><InputText id="OwnerFilter" @bind-Value="@OwnerFilter" readonly="@(!_isAdmin)"></InputText></td>
        </tr>
        <tr>
            <td><label for="TemplateFilter">Template</label></td>
            <td><InputText id="TemplateFilter" @bind-Value="@TemplateFilter"></InputText></td>
        </tr>
        <tr>
            <td><label for="CAFilter">Certificate Authority</label></td>
            <td><InputSelect id="CAFilter" @bind-Value="@CAOption">
                    @foreach (var option in Enum.GetValues<CAOptions>())
                    {
                        <option value="@option">@option</option>
                    }
            </InputSelect></td>
        </tr>
        <tr>
            <td><label for="DispositionFilter">Disposition Options</label></td>
            <td>
                <InputSelect id="DispositionFilter" @bind-Value="@DispositionOption">
                    @foreach (var option in Enum.GetValues<DispositionOptions>())
                    {
                        <option value="@option">@option</option>
                    }
                </InputSelect>
            </td>
        </tr>
        <tr>
            <td><label for="RequestIdFilter">RequestId</label></td>
            <td><InputNumber id="RequestIdFilter" @bind-Value="@requestId"></InputNumber></td>
        </tr>
        <button type="submit" class="btn-primary">Search</button>
        </table>
</EditForm>

<ErrorBoundary>
    <ChildContent>
        <QuickGrid Class="table" Items="entry" Pagination="_pagination">
            <Paginator State="_pagination" />
            <PropertyColumn Property="@(e => e.RequestId)" Title="Request" Sortable="true" />
            <TemplateColumn Title = "RequesterInformation">
                @if (context.RequestCommonName != "")
                {
                    <p style="display:inline">CN=@context.RequestCommonName<br /></p>
                }
                @if (context.RequestCountryRegion != "")
                {
                    <p style="display:inline">C=@context.RequestCountryRegion<br /></p>
                }
                @if (context.RequestCity != "")
                {
                    <p style="display:inline">L=@context.RequestCity<br /></p>
                }
                @if (context.RequestOrganization != "")
                {
                    <p style="display:inline">O=@context.RequestOrganization<br /></p>
                }
                @if (context.RequestOrganizationUnit != "")
                {
                    <p style="display:inline">OU=@context.RequestOrganizationUnit<br /></p>
                }
                @if (context.RequestEMailAddress != "")
                {
                    <p style="display:inline">E=@context.RequestEMailAddress<br /></p>
                }
            </TemplateColumn>
            <TemplateColumn Title=SubjectAlternativeNames>
                @if (context.SubjectAlternativeNames != "")
                {
                    foreach (var san in @context.SubjectAlternativeNames.Split(","))
                    {
                        <p style="display:inline">@san<br /></p>
                    }
                }
            </TemplateColumn>
            <TemplateColumn Title=EnhancedKeyUsages>
                @if (context.EKUNames != "")
                {
                    foreach (var eku in @context.EKUNames.Split(","))
                    {
                        <p style="display:inline">@eku<br /></p>
                    }
                }
            </TemplateColumn>
            <PropertyColumn Property="@(e => e.Owner)" Sortable="true" />
            <PropertyColumn Property="@(e => e.Notes)" Sortable="true" />
            <TemplateColumn Context="Entry">
                <a href="@($"certificates/edit?requestid={Entry.RequestId}&caconfig={Entry.CAConfig}")">Edit</a>
                @if (_isAdmin)
                {
                    <span> | </span>
                    <a href="@($"certificates/revoke?requestid={Entry.RequestId}&caconfig={Entry.CAConfig}")">Revoke</a>
                }
            </TemplateColumn>

        </QuickGrid>
    </ChildContent>
    <ErrorContent>
        <div class="alert alert-danger">Failed to load data. The database may be unreachable.</div>
    </ErrorContent>
</ErrorBoundary>

@code {

    public enum CAOptions
    {
        SECURECA01,
        SECURECA02,
        Extern
    }
    public CAOptions CAOption { get; set; } = CAOptions.SECURECA01;

    public enum DispositionOptions
    {
        Under_Review = 9,
        Certificate_Issued = 20,
        Certificate_Revoked = 21,
        Request_Failed = 30,
        Request_Denied = 31
    }
    public DispositionOptions DispositionOption { get; set; } = DispositionOptions.Certificate_Issued;


    public string SubjectFilter = "";
    public string OwnerFilter = "";
    public string TemplateFilter = "";
    public int? requestId = null;
    public DateTime? expirationDate = null;

    private bool _isAdmin = false;

    private System.Collections.Hashtable _filterht = new System.Collections.Hashtable();
    public void HandleSubmit(EditContext editContext)
    {
        _filterht["RequestCommonName"] = SubjectFilter;
        _filterht["Owner"] = OwnerFilter;
        _filterht["CertificateTemplate"] = TemplateFilter;
        _filterht["CAConfig"] = CAOption;
        _filterht["RequestDisposition"] = (int)DispositionOption;
    }
    private AppDbContext _context = default!;
    private PaginationState _pagination = new PaginationState { ItemsPerPage = 10 };

    private string _dbError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = UserRolesService.Roles.Contains("Administator");

        if (!_isAdmin)
        {
            OwnerFilter = UserRolesService.Username;
        }

        try
        {
            _context = certificateService.CreateDbContext();
            _filterht["RequestDisposition"] = (int)DispositionOption;
        }
        catch (Exception ex)
        {
            _dbError = $"Database error: {ex.Message}";
        }
        
    }

    private IQueryable<ExtendedEntry> entry => certificateService.GetCertificateEntries(_context, requestId, expirationDate, _filterht);

    public async ValueTask DisposeAsync() => await _context.DisposeAsync();
}

