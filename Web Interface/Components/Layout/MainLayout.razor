@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using CertificateManager.Services
@inject UserRolesService UserRolesService
@inject IConfiguration Configuration

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            Hello @user
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>



@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    string user = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (UserRolesService.IsInitialized || AuthState == null)
            return;

        var authState = await AuthState;

        var rolessid = Configuration.GetSection("Roles");

        var roles = authState.User.Claims
            .Where(claim => claim.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/denyonlysid"
                         && claim.Value == rolessid["Admin"])
            .Select(claim => "Administator");

        UserRolesService.Initialize(roles, authState.User.Identity?.Name ?? "");

        user = UserRolesService.Username;
    }
}