<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CertificateManager.Admin.Pages.Signature.Sign"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CertificateManager.Admin.Pages.Signature"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <TextBlock Text="Sign PowerShell Script"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Grid.Row="0" />
        
        <StackPanel Orientation="Horizontal" Spacing="16" Grid.Row="1">
            <ComboBox x:Name="StoreLocationCombo"
               Header="Certificate Store"
               Width="200"
               SelectedIndex="0"
               SelectionChanged="StoreLocationCombo_SelectionChanged">
            </ComboBox>
            <ComboBox x:Name="CSCertificateCombo"
                Header="Code Signing Certificate"
                Width="350"
                PlaceholderText="Select a code signing certificate...">
            </ComboBox>
        </StackPanel>
            
        <StackPanel Orientation="Horizontal" Spacing="16" Grid.Row="2">
            <ComboBox x:Name="SignatureTypeCombo"
                      Header="Signature Type"
                      Width="150"
                      SelectedIndex="0">
                <ComboBoxItem Content="Authenticode" Tag="Authenticode" />
                <ComboBoxItem Content="CMS" Tag="CMS" />
            </ComboBox>
            <TextBox x:Name="SignerInput"
                     Header="Signer"
                     IsReadOnly="True"
                     Width="150" />
            <TextBox x:Name="TimestampServerInput"
                    Header="Timestamp Server (optional)"
                    PlaceholderText="e.g. http://timestamp.digicert.com"
                    Width="250" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="16" Grid.Row="3">
            <TextBox x:Name="NotesInput"
             Header="Notes"
             Width="250" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="4">
            <Button x:Name="UploadButton"
                        Content="Upload Script File"
                        Click="UploadButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="24,8" />
            <Button x:Name="SignButton"
                        Content="Sign Script"
                        Click="SignButton_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Padding="24,8" />
            <Button x:Name="DownloadButton"
                        Content="Download Signed Script"
                        Click="DownloadButton_Click"
                        IsEnabled="False"
                        Padding="24,8" />
            <Button x:Name="VerifyButton"
                        Content="Verify Signature"
                        Click="VerifyButton_Click"
                        Padding="24,8" />
        </StackPanel>

        <Grid Grid.Row="5" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ScriptInput"
                     Grid.Column="0"
                     Header="Script Content"
                     PlaceholderText="Paste your PowerShell script here..."
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     IsSpellCheckEnabled="False"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" 
                     TextChanged="InputScript_Changed"/>

            <StackPanel Spacing="12" Padding="0,0,8,0" Grid.Column="1">
                <TextBlock Text="Signature Information"/>

                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Status:" Grid.Row="0" Grid.Column="0" />
                    <TextBlock x:Name="SigStatus" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />

                    <TextBlock Text="Signature Type:" Grid.Row="1" Grid.Column="0" />
                    <TextBlock x:Name="SigType" Grid.Row="1" Grid.Column="1" />

                    <TextBlock Text="Hash Algorithm:" Grid.Row="2" Grid.Column="0" />
                    <TextBlock x:Name="SigHashAlgorithm" Grid.Row="2" Grid.Column="1" />

                    <TextBlock Text="Signer:" Grid.Row="3" Grid.Column="0" />
                    <TextBlock x:Name="SigSigner" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />

                    <TextBlock Text="Issuer:" Grid.Row="4" Grid.Column="0" />
                    <TextBlock x:Name="SigIssuer" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />

                    <TextBlock Text="Serial Number:" Grid.Row="5" Grid.Column="0" />
                    <TextBlock x:Name="SigSerialNumber" Grid.Row="5" Grid.Column="1" />

                    <TextBlock Text="Thumbprint:" Grid.Row="6" Grid.Column="0" />
                    <TextBlock x:Name="SigThumbprint" Grid.Row="6" Grid.Column="1" />

                    <TextBlock Text="Timestamp:" Grid.Row="7" Grid.Column="0" />
                    <TextBlock x:Name="SigTimestamp" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" />

                    <TextBlock Text="Status Message:" Grid.Row="8" Grid.Column="0" />
                    <TextBlock x:Name="SigStatusMessage" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

        </Grid>

        <InfoBar x:Name="StatusBar"
                 Grid.Row="6"
                 IsOpen="False"
                 IsClosable="True" />
    </Grid>
</Page>
